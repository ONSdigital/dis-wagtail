{
  "name": "dis-wagtail",
  "version": "0.1.0",
  "author": "ONSdigital",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "browserslist": [
    "> 1% and last 2 versions",
    "Firefox ESR",
    "ios_saf 12",
    "safari 12",
    "ie 11",
    "not ie_mob 11",
    "not android 4.4.3-4.4.4",
    "not OperaMini all"
  ],
  "scripts": {
    "//[ Linting & formatting ]//": "",
    "lint": "npm run lint:css && npm run lint:format && npm run lint:js",
    "lint:css": "stylelint --report-needless-disables './cms/static_src/sass'",
    "lint:format": "prettier --check '**/?(.)*.{md,css,scss,js,json,yaml,yml}'",
    "lint:js": "eslint --ext .js --report-unused-disable-directives .",
    "format": "prettier --write '**/?(.)*.{md,css,scss,js,json,yaml,yml}'",
    "//[ Accessiblity tests ]//": "",
    "pa11y": "make pa11y",
    "//[ Build tasks ]//": "",
    "build": "webpack --mode development --progress",
    "build:prod": "webpack --mode production",
    "start": "webpack --mode development --progress --watch",
    "start:reload": "webpack-dev-server"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@eslint/js": "^9.39.5",
    "@wagtail/eslint-config-wagtail": "^0.6.0",
    "@wagtail/stylelint-config-wagtail": "^2.0.0",
    "autoprefixer": "^10.5.4",
    "babel-loader": "^9.2.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "cssnano": "^8.0.4",
    "eslint": "^9.39.5",
    "eslint-webpack-plugin": "^6.0.0",
    "globals": "^17.11.0",
    "lighthouse": "^13.4.1",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.26",
    "postcss-custom-properties": "^15.0.1",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "sass-loader": "^17.0.0",
    "stylelint": "^17.14.1",
    "stylelint-webpack-plugin": "^5.1.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "dis-authorisation-client-js": "^1.1.0"
  },
  "overrides": {
    "sockjs": {
      "uuid": "^11"
    }
  }
}
